{
  "name": "trading-bot-template",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node node_modules/@rsbuild/core/bin/rsbuild.js dev",
    "server": "npm --prefix backend run server",
    "build": "rsbuild build",
    "watch": "rsbuild build --watch",
    "serve": "http-server dist -p 8443 -a localhost -o",
    "test:lint": "prettier --log-level silent --write . && eslint src --ext .js,.jsx,.ts,.tsx",
    "test:fix": "prettier --log-level silent --write . && eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "coverage": "jest --coverage --coverageReporters=json-summary",
    "coverage:total": "npm run coverage && node -p \"require('./coverage/coverage-summary.json').total.lines.pct\"",
    "postinstall": "npm --prefix backend install",
    "prepare": "husky install",
    "build:analyze": "BUNDLE_ANALYZE=true rsbuild build",
    "generate:brand-css": "node scripts/generate-brand-css.js",
    "dev:commit-push": "powershell -ExecutionPolicy Bypass -File scripts/dev-commit-push.ps1",
    "type-check": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
